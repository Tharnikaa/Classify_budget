{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expenseit.local/contracts/schemas/receipt_extracted.schema.json",
  "title": "ExtractedReceipt",
  "description": "Factual receipt extraction output produced by Phase 2 OCR (OCRServiceProtocol) and consumed by Phase 3 Policy Engine & Phase 5 Mobile Review UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "image_sha256",
    "is_valid_receipt",
    "detected_currency",
    "tax_amount_paise",
    "total_amount_paise",
    "suggested_category_code",
    "confidence_score",
    "field_confidence",
    "line_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "image_url": {
      "type": ["string", "null"]
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_phash": {
      "type": ["string", "null"]
    },
    "is_valid_receipt": {
      "type": "boolean"
    },
    "vendor_name": {
      "type": ["string", "null"]
    },
    "vendor_tax_id": {
      "type": ["string", "null"]
    },
    "invoice_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "detected_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "subtotal_amount_paise": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "tax_amount_paise": {
      "type": "integer",
      "minimum": 0
    },
    "total_amount_paise": {
      "type": "integer",
      "minimum": 0
    },
    "suggested_category_code": {
      "type": "string",
      "minLength": 1
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "field_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "date", "total", "category"],
      "properties": {
        "vendor": { "type": "number", "minimum": 0, "maximum": 1 },
        "date": { "type": "number", "minimum": 0, "maximum": 1 },
        "total": { "type": "number", "minimum": 0, "maximum": 1 },
        "category": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "amount_paise", "item_tag"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "minimum": 0 },
          "unit_price_paise": { "type": ["integer", "null"], "minimum": 0 },
          "amount_paise": { "type": "integer", "minimum": 0 },
          "item_tag": {
            "type": "string",
            "enum": [
              "meal",
              "alcohol",
              "tobacco",
              "gift_card",
              "personal",
              "lodging",
              "transport",
              "office_supply",
              "software",
              "telecom",
              "tax_fee",
              "other"
            ]
          }
        }
      }
    }
  }
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expenseit.local/contracts/schemas/seed_policies.schema.json",
  "title": "SeedPoliciesConfig",
  "description": "Schema validating contracts/seed_policies.json (roles, spend tiers, dynamic categories, INR paise limits, and policy rules).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_currency",
    "company_timezone",
    "receipt_staleness_days",
    "blacklisted_item_tags",
    "roles",
    "spend_tiers",
    "categories",
    "tier_category_caps_paise"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "base_currency": { "type": "string", "const": "INR" },
    "company_timezone": { "type": "string", "const": "Asia/Kolkata" },
    "receipt_staleness_days": { "type": "integer", "minimum": 1 },
    "blacklisted_item_tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "roles": {
      "type": "object",
      "required": ["EMPLOYEE", "DEPT_HEAD", "FINANCE_MANAGER", "FINANCE_HEAD"],
      "additionalProperties": {
        "type": "object",
        "required": ["display_name", "description", "can_raise_claim", "permissions"],
        "properties": {
          "display_name": { "type": "string" },
          "description": { "type": "string" },
          "can_raise_claim": { "type": "boolean" },
          "permissions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "spend_tiers": {
      "type": "object",
      "required": ["JUNIOR", "SENIOR", "MANAGER", "NONE"],
      "additionalProperties": {
        "type": "object",
        "required": ["display_name", "monthly_cap_paise"],
        "properties": {
          "display_name": { "type": "string" },
          "monthly_cap_paise": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "description", "is_active"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "is_active": { "type": "boolean" }
        }
      }
    },
    "tier_category_caps_paise": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["JUNIOR", "SENIOR", "MANAGER"],
        "properties": {
          "JUNIOR": { "type": "integer", "minimum": 0 },
          "SENIOR": { "type": "integer", "minimum": 0 },
          "MANAGER": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}


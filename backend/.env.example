# ExpenseIt Backend Environment Configuration
# Copy to backend/.env (NEVER commit backend/.env)

# Environment: "development" | "staging" | "production"
# IMPORTANT: POST /api/v1/auth/dev-switch-role is disabled (404) unless APP_ENV=development
APP_ENV=development

# Database URL:
# - Local Dev (Zero-Install SQLite WAL): sqlite:///./expenseit_dev.db
# - Shared Cloud PostgreSQL (Neon / Supabase): postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./expenseit_dev.db

# JWT Configuration (Replace with >=32 byte random secret in staging/production)
JWT_SECRET=dev-only-expenseit-jwt-secret-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# CORS Allowed Origins (comma-separated, or * in local development for Expo Go LAN access)
CORS_ORIGINS=*

# Local Storage Directory for Authenticated Receipt Uploads
STORAGE_LOCAL_DIR=./uploads

# Vision AI OCR Provider Selection: "gemini" | "openai" | "anthropic" | "ollama" | "mock"
# (Auto-detected if unset based on provided API keys)
OCR_PROVIDER=

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI GPT-4o / GPT-4o-mini (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude 3.5 Sonnet / Haiku (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local / OpenAI-Compatible (Ollama, vLLM, LiteLLM)
OCR_BASE_URL=
OCR_MODEL=qwen2-vl
OCR_API_KEY=

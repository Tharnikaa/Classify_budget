# ExpenseIt Backend Environment Configuration
# Copy to backend/.env (NEVER commit backend/.env)

# Environment: "development" | "staging" | "production"
# IMPORTANT: POST /api/v1/auth/dev-switch-role is disabled (404) unless APP_ENV=development
APP_ENV=development

# Database URL:
# - Local Dev (Zero-Install SQLite WAL): sqlite:///./expenseit_dev.db
# - Shared Cloud PostgreSQL (Neon / Supabase): postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./expenseit_dev.db

# JWT Configuration (Replace with >=32 byte random secret in staging/production)
JWT_SECRET=dev-only-expenseit-jwt-secret-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# CORS Allowed Origins (comma-separated, or * in local development for Expo Go LAN access)
CORS_ORIGINS=*

# Local Storage Directory for Authenticated Receipt Uploads
STORAGE_LOCAL_DIR=./uploads

# Gemini Multimodal API Key (Phase 2 OCR — obtain free key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


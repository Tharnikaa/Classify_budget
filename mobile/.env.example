# ExpenseIt React Native / Expo Environment Configuration
# Copy to mobile/.env (NEVER commit mobile/.env)
#
# When testing on a physical phone via Expo Go, replace localhost with your laptop's Wi-Fi LAN IP
# printed by backend\scripts\dev.ps1 (e.g., http://192.168.1.42:8000/api/v1)
# On Android Emulator: http://10.0.2.2:8000/api/v1
# On iOS Simulator or Expo Web: http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Developer Role Switcher Banner (__DEV__ gated in code as well)
EXPO_PUBLIC_ENABLE_ROLE_SWITCHER=true

